{
  "name": "pushdraft",
  "version": "0.1.0",
  "description": "Command-line client for private pushover drafts.",
  "keywords": [
    "cli",
    "html",
    "preview",
    "publishing"
  ],
  "homepage": "https://pushover.dev",
  "bugs": "https://github.com/shubrt/pushover/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubrt/pushover.git",
    "directory": "apps/cli"
  },
  "bin": {
    "pushdraft": "./dist/cli.js",
    "pushover": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --format esm",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@pushover/contracts": "workspace:*",
    "@tool/tsconfig": "workspace:*",
    "@types/bun": "^1.3.4",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
