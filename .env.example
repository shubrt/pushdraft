# Copy this file to `.env` at the repository root and fill in real values.
# `.env` is shared by every workspace package and must never be committed.

# The API owns this database. Railway's generic DATABASE_URL is accepted too.
DATABASE_URL="postgres://pushover:pushover@localhost:5432/pushover"

# Canonical public origin without path, query, fragment, or trailing slash.
# HTTP is accepted only for local loopback development; deployments need HTTPS.
# Production uses https://pushover.dev.
PUBLIC_URL="http://localhost:3003"

# Signs short-lived OAuth state and per-draft grants. Use at least 32 random bytes.
SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Shoo is the browser identity provider. The default is https://shoo.dev.
SHOO_BASE_URL="https://shoo.dev"

# Maximum decoded HTML size. Upload request bodies are bounded separately.
MAX_HTML_BYTES="524288"
