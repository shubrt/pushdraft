# Copy this file to `.env` at the repository root and fill in real values.
# `.env` is shared by every workspace package and must never be committed.

# The unified TanStack Start and Elysia process owns this database.
# Deployments may provide Railway's generic DATABASE_URL instead.
PP_DATABASE_URL="postgres://pp:pp@localhost:5432/pp"

# Canonical public origin without path, query, fragment, or trailing slash.
# HTTP is accepted only for local loopback development; deployments need HTTPS.
PP_PUBLIC_URL="http://localhost:3003"

# Clerk tenant shared by the web session and MCP OAuth flow.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace-me"
CLERK_SECRET_KEY="sk_test_replace-me"

# Optional structured request-event drain. Generic AXIOM_* variables remain
# accepted as deployment fallbacks.
PP_AXIOM_DATASET=""
PP_AXIOM_TOKEN=""
